#!/usr/bin/env bash
# Gate local automático. Usa la versión fijada en `rust-toolchain.toml`; los
# controles que necesitan Node/wasm-pack y el empaquetado completo quedan en CI.
# Tampoco están acá la variante `--features telemetry` ni el fuzzing: es una
# omisión deliberada por tiempo —el gate completo corre en CI— y no un olvido.
# Para saltarlo deliberadamente: git commit --no-verify
set -euo pipefail
source "$HOME/.cargo/env" 2>/dev/null || true
# git exporta GIT_DIR/GIT_INDEX_FILE a los hooks. cargo-deny actualiza su base de
# avisos con el git del sistema, que las hereda: hacía `reset --hard FETCH_HEAD`
# sobre ESTE repo (rama movida a un commit viejo) y volcaba el árbol en la caché
# ~/.cargo/advisory-dbs. Este hook no usa git, así que se limpian todas.
unset $(git rev-parse --local-env-vars)

echo "→ pre-commit: fmt + tests + clippy + dependencias…"
cargo fmt --all --check
cargo test -p gema-compress --no-default-features --quiet 2>&1 | tail -1
cargo test -p gema-compress --features perceptual --quiet 2>&1 | tail -1
cargo test -p gema-compress --features serde --quiet 2>&1 | tail -1
cargo test -p gema-edit --no-default-features --quiet 2>&1 | tail -1
cargo test -p gema-edit --features serde --quiet 2>&1 | tail -1
cargo test -p gema-cli --quiet 2>&1 | tail -1
cargo test -p gema-wasm --quiet 2>&1 | tail -1
cargo clippy -p gema-compress --all-targets --no-default-features -- -D warnings 2>&1 | tail -1
cargo clippy -p gema-edit --all-targets --no-default-features -- -D warnings 2>&1 | tail -1
cargo clippy -p gema-cli -p gema-wasm --all-targets -- -D warnings 2>&1 | tail -1
cargo clippy -p gema-compress --all-targets --features perceptual -- -D warnings 2>&1 | tail -1
cargo clippy -p gema-compress --all-targets --features serde -- -D warnings 2>&1 | tail -1
if command -v cargo-deny >/dev/null 2>&1; then
  cargo deny check advisories bans licenses sources
else
  echo "⚠️  cargo-deny no está instalado; CI ejecutará avisos, licencias y bans."
fi
echo "✓ gates OK"
